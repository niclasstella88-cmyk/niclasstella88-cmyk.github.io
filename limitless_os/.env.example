# ============================================================
# LIMITLESS OS — Self-Healing Agent Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================


# ── n8n ──────────────────────────────────────────────────────
# Base URL of your n8n instance (no trailing slash)
N8N_BASE_URL=https://your-n8n.example.com

# n8n API key (Settings → API → Create API Key)
N8N_API_KEY=your-n8n-api-key

# How often to poll for failed executions (minutes)
N8N_POLL_INTERVAL_MINUTES=5

# Maximum failed executions to fetch per poll cycle
N8N_EXECUTIONS_LIMIT=50

# Webhook URL to trigger when a stuck draft is detected
# Create a webhook trigger node in n8n that resets draft state
N8N_STUCK_DRAFT_WEBHOOK_URL=https://your-n8n.example.com/webhook/reset-draft


# ── Google Sheets ─────────────────────────────────────────────
# Absolute path to your Google service account JSON credentials file
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# The Google Spreadsheet ID (from the URL: /spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=your-google-spreadsheet-id

# Tab names (must match exactly, case-sensitive)
DLQ_TAB_NAME=DLQ
TRACKER_TAB_NAME=Follow_Up_Tracker

# How long a draft must be in "draft_ready" state before it's considered stuck
STUCK_DRAFT_THRESHOLD_HOURS=48


# ── Anthropic / Claude ────────────────────────────────────────
# Your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Claude model for error classification
CLAUDE_MODEL=claude-sonnet-4-6

# Max tokens for classification response (keep low — response is short)
CLAUDE_MAX_TOKENS=256


# ── Telegram ──────────────────────────────────────────────────
# Create a bot via @BotFather and paste the token here
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# The chat ID to send messages to.
# For a group: get it via https://api.telegram.org/bot<TOKEN>/getUpdates
# For a personal chat: message your bot, then check getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# Time for the daily summary (HH:MM, 24-hour, local server time)
REPORT_TIME=07:45


# ── Logging ───────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Path to the JSONL decisions audit log
DECISIONS_LOG_PATH=decisions.jsonl


# ── HTTP ──────────────────────────────────────────────────────
# Total request timeout in seconds
HTTP_TIMEOUT_SECONDS=30.0

# Connection timeout in seconds
HTTP_CONNECT_TIMEOUT_SECONDS=10.0

# Maximum HTTP retry attempts before giving up
HTTP_MAX_RETRIES=3
